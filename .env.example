# portal.mipey.mx > Desarrollador > Crear API Key
PEY_API_KEY=
# Se muestra al crear el webhook (engrane de la API key). Formato whsec_...
PEY_WEBHOOK_SECRET=
# Opcional: ULID de la cuenta CoDi registrada (codiStatus ACTIVE)
PEY_BANK_ACCOUNT_ID=
# URL pública HTTPS donde corre esta app (túnel en el hackathon, tutor.aideatext.ai en producción)
PUBLIC_BASE_URL=https://tutor.aideatext.ai
PAYMENTS_DB=payments.db
# Sesión pendiente (Nivel 0 sobre conText)
PRECIO_SESION=10
CONTEXT_URL=https://context.aideatext.ai
CONTEXT_REF=sesion-pendiente
# Mismo valor que USO_TOKEN en el servicio conText de Render (para contar sesiones usadas)
CONTEXT_USO_TOKEN=
